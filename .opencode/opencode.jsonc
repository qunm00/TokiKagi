{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "[ask]",
  "plugin": ["context-mode"],
  "permission": {
    "question": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
