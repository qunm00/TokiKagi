{
  "name": "tokikagi",
  "version": "0.1.0",
  "description": "A TOTP desktop authenticator built with Tauri and SvelteKit.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "lint": "eslint . && biome check",
    "lint:fix": "eslint . --fix && biome check --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "coverage": "vitest run --coverage",
    "cargo:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-features --workspace --lcov --output-path src-tauri/lcov.info"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "melt": "^0.44.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@melt-ui/svelte": "^0.86.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
